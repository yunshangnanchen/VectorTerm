# ---------------------------------------------------------------
# 构建产物 / 上游源码
# ---------------------------------------------------------------
/target
# 构建输出 / 一次性探针与截图的归档都在 target/(含 _archive/),整目录不入库
/.wezterm-src
*.log
/logs
/watchstamp

# ---------------------------------------------------------------
# 凭据:这个仓库是终端程序,本身不连任何 API,但配置里可能被写进
# 环境变量或密钥文件 —— 在 add -A 之前就把它们挡在门外
# ---------------------------------------------------------------
.env
.env.*
*.key
*.pem
*.pfx
*.p12
*.jks
secrets.*
credentials.*
id_rsa*
id_ed25519*
.npmrc
.pypirc

# ---------------------------------------------------------------
# Python 虚拟环境(旧的 tkinter 版配置管理器已废弃,改用 settings-gui Rust 版)
# ---------------------------------------------------------------
.venv/
__pycache__/
*.py[cod]

# ---------------------------------------------------------------
# 本地文件,不入库
# ---------------------------------------------------------------
tmpceshi.lua
.workbuddy/

# 临时截图(手动产生的分屏对比图,不入库)
vectorterm_split_*.bmp

# ---------------------------------------------------------------
# 编辑器 / 系统杂物
# ---------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
desktop.ini

# 调试符号与中间文件(随 venv / 构建工具产生)
*.pdb
*.ilk

# AI 编程工具的本地缓存,不属于项目内容
.claude/
.cursor/
.continue/
.aider*
